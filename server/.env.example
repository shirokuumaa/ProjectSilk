# Скопируйте в server/.env и подставьте свои значения. Сам .env в git не попадает.

PORT=5050
MONGODB_URI=mongodb://127.0.0.1:27017/projectsilk

# Подпись токенов входа. Минимум 32 символа, у каждой установки свой.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# AI-прокси: off | proxy
AI_MODE=off
GPU_URL=http://127.0.0.1:8000

BLENDER_PATH=/Applications/Blender.app/Contents/MacOS/Blender
